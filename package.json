{
  "name": "drift",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "tsx --test packages/game-rules/*.test.ts packages/ai-contracts/*.test.ts packages/scene-contracts/*.test.ts packages/starter-content/*.test.ts packages/ai-costs/*.test.ts scripts/shake.test.ts scripts/bottle-book.test.ts scripts/drafts.test.ts scripts/csp-serialization.test.ts scripts/navigation.test.ts scripts/bottle-link.test.ts scripts/coast-time.test.ts",
    "starters:check": "tsx scripts/check-starters.ts",
    "check:server": "tsc --noEmit -p spacetimedb/tsconfig.json",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "db:publish:local": "node scripts/spacetime.mjs publish-local",
    "db:publish": "node scripts/spacetime.mjs publish",
    "db:generate": "node scripts/spacetime.mjs generate",
    "test:ui": "node scripts/test-room.mjs ui",
    "test:shore": "node scripts/test-room.mjs shore",
    "test:catch-first": "node scripts/test-room.mjs catch-first",
    "test:gate-layout": "node scripts/test-room.mjs gate-layout",
    "test:navigation": "node scripts/test-room.mjs navigation",
    "test:thanks": "node scripts/test-room.mjs thanks",
    "test:withdrawal": "node scripts/test-room.mjs withdrawal",
    "test:invitations": "node scripts/test-room.mjs invite",
    "test:coast": "node scripts/test-room.mjs coast",
    "test:retention": "node scripts/test-room.mjs retention",
    "test:hint-retries": "node scripts/test-room.mjs hint-retries",
    "test:keepsake": "node scripts/test-room.mjs keepsake",
    "test:ritual": "node scripts/test-room.mjs ritual",
    "test:letters": "node scripts/test-room.mjs letters",
    "test:returns": "node scripts/test-room.mjs returns",
    "test:unopened-upgrade": "node --import tsx scripts/unopened-upgrade.mjs",
    "test:empty": "node scripts/test-room.mjs empty",
    "test:webkit": "node scripts/test-room.mjs webkit",
    "test:recovery": "node scripts/test-room.mjs recovery",
    "test:coldstart": "node scripts/test-room.mjs coldstart",
    "benchmark:paper": "node scripts/test-room.mjs paper-benchmark",
    "test:paper-fallbacks": "node scripts/test-room.mjs paper-fallbacks",
    "test:paper-continuity": "node scripts/test-room.mjs paper-continuity",
    "test:server": "vitest run",
    "test:a11y": "node scripts/test-room.mjs a11y",
    "eval:models": "tsx scripts/eval-models.ts",
    "cost:report": "tsx scripts/cost-report.ts",
    "ops:usage": "tsx scripts/owner-usage.ts",
    "ops:activity": "tsx scripts/owner-activity.ts",
    "test:live": "node scripts/test-room.mjs live",
    "test:states": "node scripts/test-room.mjs states",
    "demo:rehearse": "node scripts/test-room.mjs demo --rehearse",
    "demo:record": "node scripts/test-room.mjs demo",
    "test:migration": "node --import tsx scripts/letter-migration.mjs",
    "test:shore-script-retry": "node scripts/test-room.mjs shore-script-retry",
    "eval:scenes": "tsx scripts/eval-scenes.ts",
    "test:scenes": "node scripts/test-room.mjs scenes",
    "test:scene-flow": "node scripts/test-room.mjs scene-flow",
    "test:scene-results": "node scripts/test-room.mjs scene-results",
    "test:scene-asset-failures": "node scripts/test-room.mjs scene-asset-failures",
    "test:scene-migration": "node --import tsx scripts/scene-migration.mjs",
    "test:upgrade-check": "node scripts/upgrade-check-fixture.mjs",
    "test:daily-clarity": "node scripts/test-room.mjs daily-clarity",
    "test:shared-landing": "node scripts/test-room.mjs shared-landing",
    "test:qr-invitation": "node scripts/test-room.mjs qr-invitation",
    "test:shore-motion": "node scripts/test-room.mjs shore-motion",
    "test:shelf-render": "node scripts/test-room.mjs shelf-render",
    "test:coast-time": "node scripts/coast-time-ui.mjs",
    "test:coast-gpu": "node scripts/coast-gpu-ui.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "@fontsource/kalam": "^5.3.0",
    "lucide-react": "^0.577.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spacetimedb": "2.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "latest",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "jsqr": "1.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
