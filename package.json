{
  "name": "drift",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "tsx --test packages/game-rules/*.test.ts packages/ai-contracts/*.test.ts packages/starter-content/*.test.ts packages/ai-costs/*.test.ts scripts/shake.test.ts scripts/bottle-book.test.ts scripts/drafts.test.ts scripts/csp-serialization.test.ts",
    "starters:check": "tsx scripts/check-starters.ts",
    "check:server": "tsc --noEmit -p spacetimedb/tsconfig.json",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "db:publish:local": "node scripts/spacetime.mjs publish-local",
    "db:publish": "node scripts/spacetime.mjs publish",
    "db:generate": "node scripts/spacetime.mjs generate",
    "test:ui": "node scripts/test-room.mjs ui",
    "test:shore": "node scripts/test-room.mjs shore",
    "test:catch-first": "node scripts/test-room.mjs catch-first",
    "test:letters": "node scripts/test-room.mjs letters",
    "test:empty": "node scripts/test-room.mjs empty",
    "test:server": "vitest run",
    "test:a11y": "node scripts/test-room.mjs a11y",
    "eval:models": "tsx scripts/eval-models.ts",
    "cost:report": "tsx scripts/cost-report.ts",
    "ops:usage": "tsx scripts/owner-usage.ts",
    "test:live": "node scripts/test-room.mjs live",
    "test:states": "node scripts/test-room.mjs states",
    "demo:rehearse": "node scripts/test-room.mjs demo --rehearse",
    "demo:record": "node scripts/test-room.mjs demo"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "@fontsource/kalam": "^5.3.0",
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spacetimedb": "2.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "latest",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
