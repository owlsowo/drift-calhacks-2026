# Server only. Never use a VITE_ prefix for an API key.
ANTHROPIC_API_KEY=
# Server-side Turnstile verification; leave empty only in local development.
DRIFT_TURNSTILE_SECRET=
DRIFT_TURNSTILE_HOSTNAME=
# Replace the sample starters with human-written lines before setting this true.
DRIFT_STARTERS_HUMAN_WRITTEN=false
# Enable only after physically verifying the public meeting point.
DRIFT_HELLO_ENABLED=false
DRIFT_MEETING_SPOT=
DRIFT_MEETING_SPOT_VERIFIED=false
